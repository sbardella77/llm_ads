# Connessione Neon (Vercel la imposta in automatico con l'integrazione Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Chiave per cifrare le API key dei clienti: openssl rand -base64 32
ENCRYPTION_KEY=
# Segreto per proteggere /api/cron/sync: openssl rand -hex 32
CRON_SECRET=
# mock = dati finti, live = API OpenAI Ads reale
ADS_API_MODE=mock
